# Copy this file to .env and fill in your key
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# LLM used to generate RAG answers (cheap model is fine)
GEN_MODEL=google/gemini-2.0-flash-001

# LLM used as judge for faithfulness / relevance / correctness (use a strong model)
JUDGE_MODEL=anthropic/claude-3.5-sonnet

# Local embedding model (sentence-transformers, no API cost)
EMBED_MODEL=BAAI/bge-small-en-v1.5
