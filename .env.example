# Copy this file to .env and fill in your keys

# ---- OpenRouter: LLM answer generation + judge ----
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# LLM used to generate RAG answers (cheap model is fine)
GEN_MODEL=google/gemini-2.5-flash-lite

# LLM used as judge for faithfulness / relevance / correctness (cheap, reliable JSON)
JUDGE_MODEL=openai/gpt-4o-mini

# ---- Google Gemini: embeddings via the OpenAI-compatible endpoint (free tier) ----
# Key from https://aistudio.google.com  ->  Get API key  (no credit card)
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
